<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DwgFlaechen</AssemblyName>
    <RootNamespace>DwgFlaechen.Wpf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>DWG Flächen</Product>

    <!-- Beim Veröffentlichen als Einzeldatei auch die nativen WPF-DLLs (wpfgfx_cor3, PresentationNative_cor3, …)
         in die .exe packen – sonst startet die App ohne diese Dateien stumm nicht. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Debug-Symbole in die DLL/EXE einbetten (keine losen .pdb-Dateien im Publish-Ordner) -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DwgFlaechen.Core\DwgFlaechen.Core.csproj" />
  </ItemGroup>

</Project>
