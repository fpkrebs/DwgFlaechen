<Window x:Class="DwgFlaechen.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DwgFlaechen.Wpf"
        Title="DWG Flächen" Width="1450" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Language="de-DE"
        FontFamily="Segoe UI" FontSize="13" Background="#F3F3F3"
        AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">

    <Window.Resources>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="NumHeader" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,4,8,4" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="RowHeight" Value="24" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="1" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="F5" Command="NavigationCommands.Refresh" />
        <KeyBinding Key="D" Modifiers="Control" Command="{x:Static local:MainWindow.CompareCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" CanExecute="Open_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Export_Executed" CanExecute="HasResult_CanExecute" />
        <CommandBinding Command="NavigationCommands.Refresh" Executed="Reload_Executed" CanExecute="HasResult_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.CompareCommand}" Executed="Compare_Executed" CanExecute="HasResult_CanExecute" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- ============ Menü ============ -->
        <Menu DockPanel.Dock="Top" Background="#F3F3F3" Padding="4,2">
            <MenuItem Header="_Datei">
                <MenuItem Header="DWG/DXF _öffnen …" Command="ApplicationCommands.Open" InputGestureText="Strg+O" />
                <MenuItem Header="_Neu laden" Command="NavigationCommands.Refresh" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="Mit zweiter DWG _vergleichen …" Command="{x:Static local:MainWindow.CompareCommand}" InputGestureText="Strg+D" />
                <MenuItem x:Name="EndCompareMenu" Header="Vergleich _beenden" Click="EndCompare_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Als _CSV exportieren …" Command="ApplicationCommands.Save" InputGestureText="Strg+S" />
                <MenuItem Header="In _Zwischenablage kopieren" Click="Copy_Click" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Objekte">
                <MenuItem x:Name="ChkPolylines" Header="Geschlossene Polylinien" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkHatches" Header="Schraffuren (Inseln werden abgezogen)" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkCircles" Header="Kreise" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkEllipses" Header="Ellipsen" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkSolids" Header="2D-Solids" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkSplines" Header="Geschlossene Splines" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkStoreplanner" Header="Storeplanner-Flächen (Proxy GIN_DBAREA)" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <Separator />
                <MenuItem x:Name="ChkBlocks" Header="Blockreferenzen auflösen" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkVisible" Header="Nur sichtbare Layer (ein, nicht gefroren)" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <MenuItem x:Name="ChkCoincident" Header="Offene Polylinien mit Start = Ende als geschlossen werten" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" />
                <Separator />
                <MenuItem Header="Übernehmen und neu laden" Command="NavigationCommands.Refresh" FontWeight="SemiBold" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="Vorschau _einpassen" Click="Fit_Click" />
                <MenuItem Header="Auf _Auswahl zoomen" Click="ZoomSelection_Click" />
                <Separator />
                <MenuItem Header="Eckpunkt-Koordinaten _kopieren" Click="CopyPoints_Click" />
                <MenuItem Header="Eckpunkt-Markierungen _löschen" Click="ClearPoints_Click" InputGestureText="Esc" />
            </MenuItem>
        </Menu>

        <!-- ============ Werkzeugleiste ============ -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F3F3F3" IsLocked="True">
            <ToolBar Background="#F3F3F3" Padding="4,2">
                <Button Command="ApplicationCommands.Open" ToolTip="DWG oder DXF öffnen (Strg+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" />
                        <TextBlock Text="Öffnen" />
                    </StackPanel>
                </Button>
                <Button Command="NavigationCommands.Refresh" ToolTip="Neu laden (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                        <TextBlock Text="Neu laden" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Static local:MainWindow.CompareCommand}" ToolTip="Zweite DWG laden und überlagert vergleichen (Strg+D)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" />
                        <TextBlock Text="Vergleichen" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="ApplicationCommands.Save" ToolTip="Sichtbare Flächen als CSV speichern (Strg+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                        <TextBlock Text="CSV exportieren" />
                    </StackPanel>
                </Button>
                <Button Click="Copy_Click" ToolTip="Tabelle (bzw. Auswahl) in die Zwischenablage – zum Einfügen in Excel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                        <TextBlock Text="Kopieren" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Click="Fit_Click" ToolTip="Vorschau einpassen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" />
                        <TextBlock Text="Einpassen" />
                    </StackPanel>
                </Button>
                <Separator />
                <TextBlock Text="Einheit:" VerticalAlignment="Center" Margin="6,0,6,0" />
                <ComboBox x:Name="UnitBox" Width="190" SelectionChanged="UnitBox_SelectionChanged" />
            </ToolBar>
        </ToolBarTray>

        <!-- ============ Statusleiste ============ -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F3F3F3" Padding="8,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="FileText" Text="Keine Datei geladen" Foreground="#555" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="PointText" Margin="16,0,0,0" Visibility="Collapsed">
                    <Run x:Name="PointRun" FontWeight="SemiBold" />
                    <Run Text="  " />
                    <Hyperlink Click="CopyPoints_Click" ToolTip="X und Y aller markierten Eckpunkte kopieren (Strg+C in der Vorschau)">kopieren</Hyperlink>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <ProgressBar x:Name="Busy" Width="140" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="TotalText" Text="Summe: –" FontSize="18" FontWeight="SemiBold" Margin="16,0,4,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="SelectionText" Foreground="#555" />
            </StatusBarItem>
        </StatusBar>

        <!-- ============ Hinweise ============ -->
        <Border x:Name="WarningBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="10,4,10,4"
                Background="#FFF4CE" BorderBrush="#E8D48A" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="CloseWarning_Click" Background="Transparent"
                        BorderThickness="0" VerticalAlignment="Top" Padding="6,0" ToolTip="Schließen" />
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- ============ Vergleich ============ -->
        <Border x:Name="CompareBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="10,4,10,4"
                Background="#EAF3FC" BorderBrush="#B5D3F0" BorderThickness="1" CornerRadius="6" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Vergleich beenden" Click="EndCompare_Click" Padding="10,2" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Abweichende Punkte …" Click="NearPoints_Click" Padding="10,2" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="Liste der Eckpunkte, die in A und B nur wenig voneinander abweichen" />
                <CheckBox x:Name="ChkCmpPoints" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0" Click="CmpPoints_Click"
                          ToolTip="Eckpunkte markieren: grün = in A und B genau gleich, rot = weicht geringfügig ab (Grenze wie unter „Abweichende Punkte …“)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#00A03C" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <Ellipse Width="9" Height="9" Fill="#DC2828" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="CmpPointsText" Text="Eckpunkte markieren" />
                    </StackPanel>
                </CheckBox>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CompareFilesText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox x:Name="ChkCmpChanged" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#006EDC" Margin="0,0,5,0" />
                            <TextBlock x:Name="CmpChangedText" Text="Geändert" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpNew" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#00A03C" Margin="0,0,5,0" />
                            <TextBlock x:Name="CmpNewText" Text="Neu" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpRemoved" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#DC2828" Margin="0,0,5,0" />
                            <TextBlock x:Name="CmpRemovedText" Text="Entfallen" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpUnchanged" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#969696" Margin="0,0,5,0" />
                            <TextBlock x:Name="CmpUnchangedText" Text="Unverändert" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Alte Kontur geänderter Flächen: rot gestrichelt" Foreground="#666" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ============ Inhalt ============ -->
        <Grid Margin="10,6,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="9*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- Tabelle + Layer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="230" MinHeight="100" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555" Margin="10,0,0,0" />
                    <Grid>
                        <TextBox x:Name="FilterBox" Padding="4,3" TextChanged="FilterBox_TextChanged" />
                        <TextBlock Text="Filtern nach Layer, Block, Typ oder Handle …" Foreground="#999" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                    <DataGrid x:Name="CompareGrid" SelectionMode="Extended" SelectionUnit="FullRow" Visibility="Collapsed"
                              SelectionChanged="CompareGrid_SelectionChanged" MouseDoubleClick="CompareGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="24" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nr" Binding="{Binding Nr}" Width="46" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            <DataGridTextColumn Header="Änderung" Binding="{Binding Details}" Width="10*" />
                            <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="10*" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="80" />
                            <DataGridTextColumn x:Name="ColCmpA" Header="Fläche A" Width="100"
                                                Binding="{Binding AreaA, StringFormat=N3, TargetNullValue=''}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColCmpB" Header="Fläche B" Width="100"
                                                Binding="{Binding AreaB, StringFormat=N3, TargetNullValue=''}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColCmpDelta" Header="Δ" Width="95"
                                                Binding="{Binding Delta, StringFormat=+0.000###;-0.000###;0}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="Δ [m²]" Width="85" SortMemberPath="Delta"
                                                Binding="{Binding DeltaM2, StringFormat=+0.000###;-0.000###;0, TargetNullValue=–}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="Beschriftung" Binding="{Binding Label}" Width="14*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="AreaGrid" SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="AreaGrid_SelectionChanged" MouseDoubleClick="AreaGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="24" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nr" Binding="{Binding Nr}" Width="50" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding Kind}" Width="90" />
                            <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="13*" />
                            <DataGridTextColumn Header="Block" Binding="{Binding Block}" Width="10*" />
                            <DataGridTextColumn x:Name="ColArea" Header="Fläche" Width="120"
                                                Binding="{Binding Area, StringFormat=N3}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="Fläche [m²]" Width="105" SortMemberPath="Area"
                                                Binding="{Binding AreaM2, StringFormat=N3, TargetNullValue=–}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColPerimeter" Header="Umfang" Width="100"
                                                Binding="{Binding Perimeter, StringFormat=N3}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColLabelArea" Header="lt. Beschr. [m²]" Width="105" Visibility="Collapsed"
                                                Binding="{Binding LabelArea, StringFormat=N2, TargetNullValue=''}"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColLabel" Header="Beschriftung" Binding="{Binding Label}" Width="18*" Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Rows" />

                <DockPanel Grid.Row="3">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Hyperlink Click="LayersAll_Click">Alle</Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink Click="LayersNone_Click">Keine</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Summe je Layer (Häkchen = in Summe enthalten)" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <Border Style="{StaticResource Card}">
                    <DataGrid x:Name="LayerGrid" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Layer" Width="*" SortMemberPath="Layer">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Layer}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Objekte" Binding="{Binding Count}" Width="70"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn x:Name="ColLayerArea" Header="Fläche" Binding="{Binding Area, StringFormat=N3}" Width="120"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="Fläche [m²]" Binding="{Binding AreaM2, StringFormat=N3, TargetNullValue=–}" Width="105"
                                                SortMemberPath="Area"
                                                ElementStyle="{StaticResource Num}" HeaderStyle="{StaticResource NumHeader}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeDirection="Columns" />

            <!-- Grafische Vorschau -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <local:PreviewCanvas x:Name="Preview" />
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" FontSize="40" Foreground="#AAA"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="DWG- oder DXF-Datei öffnen oder hierher ziehen" Foreground="#888" />
                    </StackPanel>
                    <TextBlock x:Name="CursorText" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                               FontSize="11" Foreground="#777" IsHitTestVisible="False" />
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,8,6" FontSize="11"
                               Foreground="#999" IsHitTestVisible="False" TextWrapping="Wrap"
                               Text="Mausrad: Zoom · Ziehen: Verschieben · Klick: Auswählen (Strg: mehrere) · Doppelklick: Einpassen · Klick auf Ecke: Koordinaten (Umschalt: mehrere, Esc: löschen)" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
