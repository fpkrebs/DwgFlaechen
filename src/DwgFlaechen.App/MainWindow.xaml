<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DwgFlaechen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DwgFlaechen.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DWG Flächen">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Befehlsleiste ============ -->
        <CommandBar Grid.Row="0" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
            <AppBarButton Icon="OpenFile" Label="DWG öffnen" Click="Open_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ReloadButton" Icon="Refresh" Label="Neu laden" Click="Reload_Click" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="CompareButton" Label="Vergleichen" Click="Compare_Click" IsEnabled="False"
                          ToolTipService.ToolTip="Zweite DWG laden und überlagert vergleichen (Strg+D)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8F4;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="D" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Filter" Label="Objekte">
                <AppBarButton.Flyout>
                    <Flyout x:Name="OptionsFlyout" Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="2" MinWidth="280">
                            <TextBlock Text="Objekttypen" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <CheckBox x:Name="ChkPolylines" Content="Geschlossene Polylinien" IsChecked="True" />
                            <CheckBox x:Name="ChkHatches" Content="Schraffuren (Inseln werden abgezogen)" IsChecked="True" />
                            <CheckBox x:Name="ChkCircles" Content="Kreise" IsChecked="True" />
                            <CheckBox x:Name="ChkEllipses" Content="Ellipsen" IsChecked="True" />
                            <CheckBox x:Name="ChkSolids" Content="2D-Solids" IsChecked="True" />
                            <CheckBox x:Name="ChkSplines" Content="Geschlossene Splines" IsChecked="True" />
                            <CheckBox x:Name="ChkStoreplanner" Content="Storeplanner-Flächen (Proxy GIN_DBAREA)" IsChecked="True" />
                            <Border Height="1" Margin="0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <TextBlock Text="Optionen" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <CheckBox x:Name="ChkBlocks" Content="Blockreferenzen auflösen" IsChecked="True" />
                            <CheckBox x:Name="ChkVisible" Content="Nur sichtbare Layer (ein, nicht gefroren)" IsChecked="True" />
                            <CheckBox x:Name="ChkCoincident" Content="Offene Polylinien mit Start = Ende als geschlossen werten" IsChecked="True" />
                            <Button Content="Übernehmen" Click="ApplyOptions_Click" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right" Margin="0,8,0,0" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarElementContainer VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <TextBlock Text="Einheit:" VerticalAlignment="Center" />
                    <ComboBox x:Name="UnitBox" Width="190" SelectionChanged="UnitBox_SelectionChanged" />
                </StackPanel>
            </AppBarElementContainer>
            <AppBarSeparator />
            <AppBarButton x:Name="ExportButton" Icon="Save" Label="CSV exportieren" Click="Export_Click" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Kopieren" Click="Copy_Click" IsEnabled="False"
                          ToolTipService.ToolTip="Tabelle (bzw. Auswahl) in die Zwischenablage – zum Einfügen in Excel" />
            <AppBarButton Icon="FullScreen" Label="Einpassen" Click="Fit_Click" />
            <AppBarButton Icon="Zoom" Label="Auf Auswahl" Click="ZoomSelection_Click"
                          ToolTipService.ToolTip="Vorschau auf die ausgewählten Flächen zoomen" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Copy" Label="Eckpunkt-Koordinaten kopieren" Click="CopyPoints_Click" />
                <AppBarButton Icon="Clear" Label="Eckpunkt-Markierungen löschen" Click="ClearPoints_Click"
                              KeyboardAcceleratorTextOverride="Esc" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- ============ Hinweise ============ -->
        <InfoBar x:Name="WarningBar" Grid.Row="1" Margin="12,0,12,8" IsOpen="False" Severity="Warning" Title="Hinweise" />

        <!-- ============ Vergleich ============ -->
        <Border x:Name="CompareBar" Grid.Row="2" Margin="12,0,12,8" Padding="12,8" CornerRadius="8" BorderThickness="1"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock x:Name="CompareFilesText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkCmpChanged" IsChecked="True" MinWidth="0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#006EDC" VerticalAlignment="Center" />
                            <TextBlock x:Name="CmpChangedText" Text="Geändert" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpNew" IsChecked="True" MinWidth="0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#00A03C" VerticalAlignment="Center" />
                            <TextBlock x:Name="CmpNewText" Text="Neu" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpRemoved" IsChecked="True" MinWidth="0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#DC2828" VerticalAlignment="Center" />
                            <TextBlock x:Name="CmpRemovedText" Text="Entfallen" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ChkCmpUnchanged" IsChecked="True" MinWidth="0" Click="CompareFilter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="12" Height="12" CornerRadius="2" Background="#969696" VerticalAlignment="Center" />
                            <TextBlock x:Name="CmpUnchangedText" Text="Unverändert" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="Alte Kontur geänderter Flächen: rot gestrichelt" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkCmpPoints" MinWidth="0" Click="CmpPoints_Click"
                              ToolTipService.ToolTip="Eckpunkte markieren: grün = in A und B genau gleich, rot = weicht geringfügig ab (Grenze wie unter „Abweichende Punkte …“)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="9" Height="9" Fill="#00A03C" VerticalAlignment="Center" />
                            <Ellipse Width="9" Height="9" Fill="#DC2828" VerticalAlignment="Center" />
                            <TextBlock x:Name="CmpPointsText" Text="Eckpunkte markieren" Margin="2,0,0,0" />
                        </StackPanel>
                    </CheckBox>
                    <Button Content="Abweichende Punkte …" Click="NearPoints_Click"
                            ToolTipService.ToolTip="Liste der Eckpunkte, die in A und B nur wenig voneinander abweichen" />
                    <Button Content="Vergleich beenden" Click="EndCompare_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Inhalt ============ -->
        <Grid Grid.Row="3" Margin="12,0,12,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="480" />
                <ColumnDefinition Width="9*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Tabelle + Layer -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FilterBox" PlaceholderText="Filtern nach Layer, Block, Typ, Beschriftung oder Handle …"
                             TextChanged="FilterBox_TextChanged" />
                    <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- Tabelle -->
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeaderGrid" Padding="16,8,28,8" ColumnSpacing="8"
                              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="13*" />
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition x:Name="HeaderLabelAreaCol" Width="0" />
                                <ColumnDefinition x:Name="HeaderLabelCol" Width="0" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nr" Tag="Nr" Tapped="Header_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Typ" Tag="Kind" Tapped="Header_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Layer" Tag="Layer" Tapped="Header_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Block" Tag="Block" Tapped="Header_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="AreaHeader" Grid.Column="4" Text="Fläche" Tag="Area" Tapped="Header_Tapped"
                                       HorizontalTextAlignment="Right" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="Fläche [m²]" Tag="Area" Tapped="Header_Tapped"
                                       HorizontalTextAlignment="Right" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PerimeterHeader" Grid.Column="6" Text="Umfang" Tag="Perimeter" Tapped="Header_Tapped"
                                       HorizontalTextAlignment="Right" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="lt. Beschr. [m²]" Tag="LabelArea" Tapped="Header_Tapped"
                                       HorizontalTextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="8" Text="Beschriftung" Tag="Label" Tapped="Header_Tapped"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>

                        <ListView x:Name="AreaList" Grid.Row="1" SelectionMode="Extended"
                                  SelectionChanged="AreaList_SelectionChanged" DoubleTapped="AreaList_DoubleTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AreaRow">
                                    <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="13*" />
                                            <ColumnDefinition Width="10*" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="{x:Bind LabelColumnWidth}" />
                                            <ColumnDefinition Width="{x:Bind LabelTextColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{x:Bind Swatch}" />
                                            <TextBlock Text="{x:Bind NrText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind KindText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Layer}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Block}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind AreaText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind AreaM2Text}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind PerimeterText}" VerticalAlignment="Center" HorizontalTextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind LabelAreaText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="8" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Vergleichstabelle (nur im Vergleichsmodus) -->
                        <Grid x:Name="CompareHeaderGrid" Padding="16,8,28,8" ColumnSpacing="8" Visibility="Collapsed"
                              BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="12*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nr" Tag="Nr" Tapped="CompareHeader_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Status" Tag="Status" Tapped="CompareHeader_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Änderung" Tag="Details" Tapped="CompareHeader_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Layer" Tag="Layer" Tapped="CompareHeader_Tapped" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="CmpAHeader" Grid.Column="4" Text="Fläche A" Tag="A" Tapped="CompareHeader_Tapped"
                                       HorizontalTextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="CmpBHeader" Grid.Column="5" Text="Fläche B" Tag="B" Tapped="CompareHeader_Tapped"
                                       HorizontalTextAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="CmpDeltaHeader" Grid.Column="6" Text="Δ" Tag="Delta" Tapped="CompareHeader_Tapped"
                                       HorizontalTextAlignment="Right" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="Δ [m²]" Tag="Delta" Tapped="CompareHeader_Tapped"
                                       HorizontalTextAlignment="Right" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Grid.Column="8" Text="Beschriftung" Tag="Label" Tapped="CompareHeader_Tapped"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>

                        <ListView x:Name="CompareList" Grid.Row="1" SelectionMode="Extended" Visibility="Collapsed"
                                  SelectionChanged="CompareList_SelectionChanged" DoubleTapped="CompareList_DoubleTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="30" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CompareRow">
                                    <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="10*" />
                                            <ColumnDefinition Width="10*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="12*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{x:Bind Swatch}" />
                                            <TextBlock Text="{x:Bind NrText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Details}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Layer}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind AreaAText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind AreaBText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind DeltaText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind DeltaM2Text}" VerticalAlignment="Center" HorizontalTextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="8" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Layer-Summen -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Summe je Layer" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Grid.Column="1" Content="Alle" Click="LayersAll_Click" />
                    <HyperlinkButton Grid.Column="2" Content="Keine" Click="LayersNone_Click" />
                </Grid>
                <Border Grid.Row="3" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView x:Name="LayerList" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LayerRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="115" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{x:Bind Swatch}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Layer}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalTextAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind CountText}" /><Run Text=" Obj." />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AreaText}" VerticalAlignment="Center" HorizontalTextAlignment="Right" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalTextAlignment="Right">
                                        <Run Text="{x:Bind AreaM2Text}" /><Run Text=" m²" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- Grafische Vorschau -->
            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid x:Name="PreviewHost" Background="Transparent"
                      SizeChanged="PreviewHost_SizeChanged"
                      PointerWheelChanged="PreviewHost_PointerWheelChanged"
                      PointerPressed="PreviewHost_PointerPressed"
                      PointerMoved="PreviewHost_PointerMoved"
                      PointerReleased="PreviewHost_PointerReleased"
                      PointerCaptureLost="PreviewHost_PointerCaptureLost"
                      PointerExited="PreviewHost_PointerExited"
                      DoubleTapped="PreviewHost_DoubleTapped">
                    <Canvas x:Name="Scene" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="SceneTransform" />
                        </Canvas.RenderTransform>
                    </Canvas>

                    <!-- Eckpunkt-Markierungen und Koordinaten (Bildschirmkoordinaten, feste Größe) -->
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" />

                    <TextBlock x:Name="CursorText" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"
                               Style="{StaticResource CaptionTextBlockStyle}" IsHitTestVisible="False"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="DWG- oder DXF-Datei öffnen oder hierher ziehen" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8"
                               Style="{StaticResource CaptionTextBlockStyle}" IsHitTestVisible="False"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"
                               Text="Mausrad: Zoom · Ziehen: Verschieben · Klick: Auswählen (Strg: mehrere) · Doppelklick: Einpassen · Klick auf Ecke: Koordinaten (Umschalt: mehrere, Esc: löschen, Strg+C: kopieren)" />
                </Grid>
            </Border>

            <ProgressRing x:Name="Busy" Grid.ColumnSpan="2" Width="56" Height="56" IsActive="False" IsHitTestVisible="False"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- ============ Statusleiste ============ -->
        <Grid Grid.Row="4" Padding="16,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FileText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Keine Datei geladen" />
            <StackPanel x:Name="PointPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <TextBlock x:Name="PointText" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <HyperlinkButton Content="kopieren" Click="CopyPoints_Click" Padding="4,0" VerticalAlignment="Center"
                                 ToolTipService.ToolTip="X und Y aller markierten Eckpunkte kopieren (Strg+C)" />
            </StackPanel>
            <TextBlock x:Name="SelectionText" Grid.Column="2" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TotalText" Grid.Column="3" VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" Text="Summe: –" />
        </Grid>
    </Grid>
</Window>
